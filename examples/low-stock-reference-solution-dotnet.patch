+    [Fact]
+    public void LowStock_returns_only_items_at_or_below_a_positive_threshold()
+    {
+        var store = new InventoryStore();
+        store.Add("A", "a", 3);
+        store.Add("B", "b", 9);
+        store.Add("C", "c", 1);
+        store.SetThreshold("A", 5);
+        store.SetThreshold("B", 5);
+
+        var low = store.LowStock();
+
+        Assert.Equal(new[] { "A" }, low.Select(i => i.Sku).ToArray());
+    }
+
+    [Fact]
+    public void LowStock_is_empty_not_null_when_nothing_is_low()
+    {
+        Assert.Empty(new InventoryStore().LowStock());
+    }
+
+    [Fact]
+    public void SetThreshold_rejects_unknown_sku_and_negative_values()
+    {
+        var store = new InventoryStore();
+        store.Add("A", "a", 1);
+
+        Assert.Throws<ItemNotFoundException>(() => store.SetThreshold("missing", 1));
+        Assert.Throws<InvalidThresholdException>(() => store.SetThreshold("A", -1));
+    }
+
+    [Fact]
+    public void Add_and_Remove_preserve_the_threshold()
+    {
+        var store = new InventoryStore();
+        store.Add("A", "a", 5);
+        store.SetThreshold("A", 4);
+
+        var afterAdd = store.Add("A", null, 1);
+        var afterRemove = store.Remove("A", 1);
+
+        Assert.Equal(4, afterAdd.Threshold);
+        Assert.Equal(4, afterRemove.Threshold);
+    }
 }
