+    /// <summary>Sets the reorder threshold. Zero disables low-stock flagging.</summary>
+    public Item SetThreshold(string sku, int threshold)
+    {
+        if (threshold < 0)
+        {
+            throw new InvalidThresholdException();
+        }
+
+        lock (_gate)
+        {
+            if (!_items.TryGetValue(sku, out var existing))
+            {
+                throw new ItemNotFoundException(sku);
+            }
+
+            var updated = existing with { Threshold = threshold };
+            _items[sku] = updated;
+            return updated;
+        }
+    }
+
+    /// <summary>Items with Threshold &gt; 0 and Quantity &lt;= Threshold, sorted by SKU.</summary>
+    public IReadOnlyList<Item> LowStock() =>
+        List().Where(i => i.Threshold > 0 && i.Quantity <= i.Threshold).ToList();
