+
+// SetThreshold sets the reorder threshold for sku. Zero disables low-stock flagging.
+func (s *Store) SetThreshold(sku string, threshold int) (Item, error) {
+	if threshold < 0 {
+		return Item{}, ErrInvalidThreshold
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	it, ok := s.items[sku]
+	if !ok {
+		return Item{}, fmt.Errorf("%w: %s", ErrNotFound, sku)
+	}
+	it.Threshold = threshold
+	s.items[sku] = it
+	return it, nil
+}
+
+// LowStock returns items with threshold > 0 and quantity <= threshold, sorted by SKU.
+func (s *Store) LowStock() []Item {
+	out := []Item{}
+	for _, it := range s.List() {
+		if it.Threshold > 0 && it.Quantity <= it.Threshold {
+			out = append(out, it)
+		}
+	}
+	return out
+}
