+func TestThresholdAndLowStock(t *testing.T) {
+	s := NewStore()
+	_, _ = s.Add("A", "a", 3)
+	_, _ = s.Add("B", "b", 9)
+	_, _ = s.Add("C", "c", 1)
+
+	if _, err := s.SetThreshold("A", 5); err != nil {
+		t.Fatalf("SetThreshold: %v", err)
+	}
+	if _, err := s.SetThreshold("B", 5); err != nil {
+		t.Fatalf("SetThreshold: %v", err)
+	}
+	if _, err := s.SetThreshold("missing", 1); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("got %v, want ErrNotFound", err)
+	}
+	if _, err := s.SetThreshold("A", -1); !errors.Is(err, ErrInvalidThreshold) {
+		t.Fatalf("got %v, want ErrInvalidThreshold", err)
+	}
+	got := s.LowStock()
+	if len(got) != 1 || got[0].SKU != "A" {
+		t.Fatalf("LowStock = %+v, want only A", got)
+	}
+}
+
+func TestLowStockEmptyIsNotNil(t *testing.T) {
+	if got := NewStore().LowStock(); got == nil {
+		t.Fatal("LowStock must return an empty slice, not nil (JSON [] not null)")
+	}
+}
