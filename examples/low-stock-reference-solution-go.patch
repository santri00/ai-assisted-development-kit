+func TestThresholdStatusCodes(t *testing.T) {
+	h := New(inventory.NewStore())
+	do(t, h, "POST", "/items/A/add", `{"quantity":1}`)
+	if rec := do(t, h, "POST", "/items/nope/threshold", `{"threshold":1}`); rec.Code != http.StatusNotFound {
+		t.Fatalf("got %d, want 404", rec.Code)
+	}
+	if rec := do(t, h, "POST", "/items/A/threshold", `{"threshold":-1}`); rec.Code != http.StatusBadRequest {
+		t.Fatalf("got %d, want 400", rec.Code)
+	}
+}
