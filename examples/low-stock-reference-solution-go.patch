+func TestLowStockEndpoint(t *testing.T) {
+	h := New(inventory.NewStore())
+	do(t, h, "POST", "/items/A/add", `{"name":"Alpha","quantity":3}`)
+	do(t, h, "POST", "/items/B/add", `{"name":"Beta","quantity":9}`)
+
+	if rec := do(t, h, "POST", "/items/A/threshold", `{"threshold":5}`); rec.Code != http.StatusOK {
+		t.Fatalf("threshold: %d %s", rec.Code, rec.Body)
+	}
+	do(t, h, "POST", "/items/B/threshold", `{"threshold":5}`)
+
+	rec := do(t, h, "GET", "/items/low-stock", "")
+	if rec.Code != http.StatusOK {
+		t.Fatalf("low-stock: %d %s", rec.Code, rec.Body)
+	}
+	body := rec.Body.String()
+	if !strings.Contains(body, `"sku":"A"`) || strings.Contains(body, `"sku":"B"`) {
+		t.Fatalf("unexpected body: %s", body)
+	}
+}
